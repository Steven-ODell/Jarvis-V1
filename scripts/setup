#!/usr/bin/env bash
# Build everything Jarvis needs that git doesn't carry: the venv, ~450 MB of
# speech models, the Playwright MCP server, the systemd unit, and the PATH
# link. Idempotent; the dotfiles install.sh calls this.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$PWD"

command -v uv >/dev/null || { echo "jarvis: needs uv"; exit 1; }
[ -x .venv/bin/python ] || uv venv -q --python 3.12 .venv
uv sync -q

mkdir -p models
KOKORO=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0
for f in kokoro-v1.0.onnx voices-v1.0.bin; do
  [ -s "models/$f" ] || curl -fsSL -o "models/$f" "$KOKORO/$f"
done
# Whisper base.en (~145 MB) comes from Hugging Face on first load; fetch it
# now so the first hotkey press isn't a download.
.venv/bin/python -c "from faster_whisper import WhisperModel; WhisperModel('base.en', device='cpu', compute_type='int8', download_root='models/whisper')" 2>/dev/null

NODE="$(ls -d "$HOME"/.local/share/mise/installs/node/*/bin 2>/dev/null | sort -V | tail -1)"
if [ -n "$NODE" ] && [ ! -e browser/node_modules/@playwright/mcp/cli.js ]; then
  (cd browser && PATH="$NODE:$PATH" npm install -s)
fi

mkdir -p "$HOME/.config/systemd/user" "$HOME/.local/bin" "$HOME/.local/share/applications"
ln -sfn "$ROOT/systemd/jarvis.service" "$HOME/.config/systemd/user/jarvis.service"
ln -sfn "$ROOT/.venv/bin/jarvis" "$HOME/.local/bin/jarvis"
ln -sfn "$ROOT/desktop/jarvis-settings.desktop" "$HOME/.local/share/applications/jarvis-settings.desktop"
systemctl --user daemon-reload
systemctl --user enable --now jarvis.service
echo "jarvis ready: SUPER+A to talk, 'jarvis settings' for options"
